{
  "$name": "dwhiepaint — Refined Apple Glass",
  "$description": "Design tokens for a light/dark glassmorphism UI. Values mirror frontend/src/index.css. Machine-readable companion to tokens.css.",
  "font": {
    "sans": "Manrope",
    "display": "Cormorant",
    "sansStack": "'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "displayStack": "'Cormorant', 'Times New Roman', Georgia, serif",
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Cormorant:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
  },
  "color": {
    "light": {
      "bg": "#f4f6fb",
      "bg-2": "#eef1f8",
      "surface": "#ffffff",
      "surface-2": "#f2f4f9",
      "text": "#14161c",
      "text-secondary": "#5b6170",
      "text-tertiary": "#878d9c",
      "border": "#d7dbe6",
      "border-soft": "#e6e9f2",
      "accent": "#0a74f0",
      "accent-hover": "#1e82ff",
      "accent-press": "#0064d6",
      "on-accent": "#ffffff",
      "danger": "#d70015",
      "ok": "#1d8a3f",
      "nav-bg": "rgba(255, 255, 255, 0.6)",
      "aurora-1": "rgba(120, 160, 255, 0.16)",
      "aurora-2": "rgba(150, 214, 224, 0.13)",
      "aurora-3": "rgba(198, 166, 255, 0.15)",
      "grain-opacity": 0.035
    },
    "dark": {
      "bg": "#080a0f",
      "bg-2": "#0d1017",
      "surface": "#161a22",
      "surface-2": "#1e232d",
      "text": "#f2f4f8",
      "text-secondary": "#a2a9b8",
      "text-tertiary": "#767d8c",
      "border": "#2b313d",
      "border-soft": "#222834",
      "accent": "#3d9bff",
      "accent-hover": "#5aabff",
      "accent-press": "#2b86ff",
      "on-accent": "#ffffff",
      "danger": "#ff453a",
      "ok": "#30d158",
      "nav-bg": "rgba(10, 13, 20, 0.55)",
      "aurora-1": "rgba(60, 120, 255, 0.3)",
      "aurora-2": "rgba(40, 190, 200, 0.22)",
      "aurora-3": "rgba(150, 90, 240, 0.26)",
      "grain-opacity": 0.05,
      "$note": "OS-dark uses hotter aurora (aurora-1 rgba(52,112,255,0.62), aurora-2 rgba(34,196,214,0.42), aurora-3 rgba(146,100,246,0.6)); the [data-theme=dark] override above is calmer for a manual toggle."
    }
  },
  "shadow": {
    "light": {
      "sm": "0 1px 2px rgba(19, 24, 40, 0.05)",
      "base": "0 8px 30px -12px rgba(19, 24, 40, 0.18)",
      "lg": "0 24px 60px -20px rgba(19, 24, 40, 0.28)"
    },
    "dark": {
      "sm": "0 1px 2px rgba(0, 0, 0, 0.5)",
      "base": "0 10px 34px -12px rgba(0, 0, 0, 0.7)",
      "lg": "0 28px 64px -20px rgba(0, 0, 0, 0.8)"
    }
  },
  "glass": {
    "bg": "color-mix(in srgb, var(--surface) 66%, transparent)",
    "bg-2": "color-mix(in srgb, var(--surface-2) 62%, transparent)",
    "border": "color-mix(in srgb, var(--text) 12%, transparent)",
    "highlight-light": "color-mix(in srgb, #ffffff 60%, transparent)",
    "highlight-dark": "color-mix(in srgb, #ffffff 22%, transparent)",
    "blur": "22px",
    "recipe": "background:var(--glass-bg); border:1px solid var(--glass-border); border-radius:var(--radius-xl); box-shadow:var(--shadow), inset 0 1px 0 var(--glass-hi); backdrop-filter:blur(var(--glass-blur)) saturate(160%)"
  },
  "radius": {
    "sm": "8px",
    "base": "12px",
    "lg": "18px",
    "xl": "26px",
    "pill": "980px"
  },
  "easing": {
    "ease": "cubic-bezier(0.4, 0, 0.2, 1)",
    "out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "motion": {
    "microDuration": "150-250ms",
    "transitionDuration": "300-400ms",
    "hoverLift": "translateY(-1px..-6px)",
    "pressScale": "scale(0.97)",
    "note": "Enter with --ease-out, springy thumbs/swatches with --ease-spring, everything gated behind prefers-reduced-motion."
  }
}
